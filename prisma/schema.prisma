generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

model Phone {
  id             String    @id @default(cuid())
  brand          String
  model          String
  os             String
  price          Int
  displayJson    String?
  cameraJson     String?
  batteryJson    String?
  soc            String
  ramGb          Int
  storageGb      Int
  weightG        Int?
  dimsMm         String?
  releaseDate    DateTime?
  imagesJson     String?
  highlightsJson String?
}
